# RubyClaw secrets — an example. The real .env is written by `claw setup`, is
# gitignored, and should be chmod 600. Nothing here is ever read from chat.

# The model API key. Any OpenAI-compatible provider's key. Not needed if base_url
# points at a local server (Ollama, LM Studio, llama.cpp).
CLAW_API_KEY=sk-...

# Telegram bot token from @BotFather. Optional: without it, `claw telegram` and
# `claw up` explain what to do instead of failing obscurely.
CLAW_TELEGRAM_TOKEN=123456:AA...

# --- optional overrides ------------------------------------------------------
# CLAW_MODEL / CLAW_BASE_URL override config.yml without editing it.
# CLAW_TELEGRAM_ALLOWED=1487339123   # comma-separated chat ids, same effect as
#                                    # telegram_allowed_chat_ids in config.yml
# CLAW_TELEGRAM_API_BASE=http://127.0.0.1:8899   # point the adapter at
#                                                # scripts/tg_stub.rb for testing
# CLAW_RUBY=/path/to/ruby            # read by the ./rubyclaw entry point
# CLAW_HOME=~/.rubyclaw              # where the entry point installs Ruby
